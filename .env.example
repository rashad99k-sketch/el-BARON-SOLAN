# GROK6 configuration template. Values below are intentionally blank until you fill them in.
# ============================================================================
# 🟣 KEYS / TOKENS — paste each value immediately after the equals sign (=).
# Keep this file local. Never upload a real .env to GitHub or send secrets in chat.
# LIVE WALLET: use a dedicated low-balance wallet. The private key can spend funds.
GROK6_SOLANA_PRIVATE_KEY=
GROK6_PHANTOM_PUBLIC_ADDRESS=
JUPITER_API_KEY=
# Optional: explicit RPC URL wins. If blank and HELIUS_API_KEY is set, Helius Mainnet RPC is built automatically.
SOLANA_RPC_URL=
HELIUS_API_KEY=
PUMPPORTAL_API_KEY=
RUGCHECK_API_KEY=
X_API_BEARER_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# 🟣 LIVE remains disabled by default. Only change after local validation.
GROK6_MODE=PAPER
GROK6_LIVE_TRADING=false
GROK6_KILL_SWITCH=false
GROK6_LIVE_DB_PATH=./grok6_live.db
# 🟣 LIVE risk guardrails: max $2 per entry; retain 0.03 SOL for network fees.
GROK6_LIVE_MAX_TRADE_USD=2.0
GROK6_LIVE_MIN_SOL_RESERVE=0.03
GROK6_LIVE_MAX_PRICE_DEVIATION_PCT=0.12
GROK6_LIVE_ESTIMATED_TX_FEE_USD=0.01
# ============================================================================

GROK6_HOST=127.0.0.1
GROK6_PORT=8080
GROK6_LOG_LEVEL=INFO
GROK6_DB_PATH=./grok6.db

GROK6_INITIAL_EQUITY=20
GROK6_MAX_POSITION_NOTIONAL=2
GROK6_MAX_TOTAL_OPEN_EXPOSURE=6
GROK6_MAX_TOTAL_OPEN_POSITIONS=6
GROK6_MAX_TECHNICAL_POSITIONS=5
GROK6_MAX_FAST_LAUNCH_POSITIONS=2
GROK6_RISK_PER_TRADE_PCT=0.005
GROK6_MAX_AGGREGATE_OPEN_RISK_PCT=0.02
GROK6_DAILY_REALIZED_LOSS_LOCK=-1

GROK6_TAKER_FEE_BPS=30
GROK6_SLIPPAGE_BPS=60
GROK6_PRICE_IMPACT_BPS=40
GROK6_MIN_LIQUIDITY_USD=8000
GROK6_MIN_NET_REWARD_RISK=1.6
GROK6_MAX_ENTRY_EXTENSION_PCT=0.06
GROK6_FAST_LAUNCH_ENABLED=true

GROK6_SCAN_INTERVAL_SECONDS=30
GROK6_PROVIDER_TIMEOUT_SECONDS=8
GROK6_PROVIDER_MAX_RETRIES=3
GROK6_CANDIDATE_TTL_SECONDS=900
GROK6_DAILY_TZ=UTC

# New-token and migration discovery can be attempted without a key; leave enabled.
# Do not enable metered trade/account subscriptions unless you intend to pay provider fees.
PUMPPORTAL_ENABLED=true

# Secondary Solana pool-discovery feed. Public beta API; cached for 60 seconds to
# respect approximate public limits. Disable with false if you do not want it.
GROK6_GECKOTERMINAL_ENABLED=true


GROK6_MAX_SELL_ROUTE_PRICE_IMPACT_PCT=5.0

GROK6_HELIUS_POLL_INTERVAL_SECONDS=30
GROK6_HELIUS_MAX_WALLETS_PER_CYCLE=10

# V7 event-driven Fast Launch Sniper. Does not bypass safety or risk gates.
GROK6_SNIPER_CANDIDATE_TTL_SECONDS=900
GROK6_SNIPER_MAX_ENTRY_AGE_SECONDS=45
GROK6_EVENT_QUEUE_SIZE=5000
GROK6_EVENT_WORKERS=4
GROK6_RETRY_BASE_DELAY_SECONDS=2
GROK6_RETRY_MAX_DELAY_SECONDS=60
GROK6_RETRY_MAX_ATTEMPTS=8
GROK6_CONTINUATION_MIN_LIQUIDITY_USD=20000
GROK6_CONTINUATION_INTERVAL_SECONDS=12
GROK6_CONTINUATION_OBSERVATION_COOLDOWN_SECONDS=20
GROK6_CONTINUATION_MAX_CANDIDATES_PER_CYCLE=8

# Fast-launch profit runner: take half at TP1, then let the remaining half run
# after TP2 activation with a ratcheting trailing stop. Returns are NOT guaranteed.
GROK6_FAST_LAUNCH_MAX_ENTRY_EXTENSION_PCT=0.18
GROK6_FAST_LAUNCH_MAX_5M_MOVE_PCT=35
GROK6_FAST_LAUNCH_STOP_PCT=0.12
GROK6_FAST_LAUNCH_TP1_RETURN_PCT=0.30
GROK6_FAST_LAUNCH_RUNNER_ACTIVATION_PCT=0.75
GROK6_FAST_LAUNCH_RUNNER_TRAIL_DRAWDOWN_PCT=0.22
GROK6_FAST_LAUNCH_RUNNER_ENABLED=true
GROK6_POSITION_MONITOR_INTERVAL_SECONDS=3
GROK6_POSITION_PRICE_CACHE_TTL_SECONDS=2

GROK6_SOCIAL_RADAR_ENABLED=true
GROK6_SOCIAL_POLL_INTERVAL_SECONDS=60
GROK6_SOCIAL_MAX_ITEMS=500
